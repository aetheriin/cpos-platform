# Salin menjadi backend/.env lalu isi. Penjelasan lengkap tiap nilai: README.md dan inti/konfigurasi.py.

# ===== Gabungan dengan CPOS =====
# Diisi = login, sesi, dan hak akses laporan mengikuti CPOS (laporan dibuka dari menu CPOS /an/<id>).
# Alamat CPOS yang bisa dihubungi server ini (bukan alamat untuk browser). Kosong = Analytics berdiri sendiri dengan login sendiri.
CPOS_URL=http://127.0.0.1:5000
CPOS_COOKIE=wb_sesi

# ===== Database data laporan (stored procedure ERP) =====
DB_SERVER=nama_server_sql
DB_NAME=nama_database_erp
DB_USER=
DB_PASSWORD=

# ===== Database akun (hanya dipakai bila CPOS_URL kosong) =====
# DB_APP_SERVER=
# DB_APP_NAME=
# DB_APP_USER=
# DB_APP_PASSWORD=

# ===== Server =====
# Satu proses saja (data laporan disimpan di memori proses): uvicorn api:app --host 127.0.0.1 --port 8001
COOKIE_SECURE=0
