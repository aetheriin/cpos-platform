# Pengaturan semua aplikasi (CPOS, RekapIn, Analytics, Deteksi Plat). Salin menjadi backend\.env lalu isi.
# Cukup tulis yang berbeda dari bawaan. File .env tidak ikut git.

# ===== Wajib =====
SECRET_KEY=isi_dengan_random_string_panjang
HASH_SECRET_KEY=isi_dengan_random_string_panjang_lain
DB_SERVER=nama_server_sql
DB_NAME=Main
DB_USER=
DB_PASSWORD=

# ===== Analytics =====
# Akun database khusus laporan (kosong = DB_USER / DB_PASSWORD)
ANALYTICS_DB_USER=
ANALYTICS_DB_PASSWORD=

# ===== Server (bawaan) =====
# PORT=5000                 port web CPOS (Analytics memeriksa login ke http://127.0.0.1:<PORT>)
# HOST=0.0.0.0              127.0.0.1 bila di belakang reverse proxy (Caddy / IIS)
# THREADS=8
# BEHIND_PROXY=0            HTTPS lewat Caddy / IIS: BEHIND_PROXY=1 dan COOKIE_SECURE=1
# COOKIE_SECURE=0
# ANALYTICS_URL=/analytics  pengembangan frontend: http://localhost:5173/analytics

# ===== Deteksi Plat (bawaan) =====
# DETEKTOR_PORT=8000        port internal, hanya dihubungi CPOS di PC yang sama
# FOLDER_FOTO=              folder foto plat (kosong = backend\deteksi\foto_bukti)

# ===== RekapIn & modul (bawaan) =====
# HARGA_TABEL=Main.dbo.HARGA   harga CPO & Kernel dari tabel RekapIn (kosong = dbo.DailyPrice CPOS)
# Database lain hanya bila tidak sama dengan DB_* (yang kosong ikut DB_*):
#   REKAPIN_ERP_SERVER / _DB / _USER / _PASSWORD          prosedur laporan TBS & tiket ERP
#   SQLSERVER_PRICE_SERVER / _DATABASE / _UID / _PWD      tabel HARGA_TABEL
#   ITEM_REQUEST_SERVER / _DB / _USER / _PASSWORD         Item Request (bawaan database Main)

# ===== Keamanan & sesi (bawaan; bisa juga diubah di Admin › Pengaturan) =====
# SESI_IDLE_MENIT=120  SESI_MAKS_JAM=12  LOGIN_MAKS_GAGAL=5  LOGIN_JENDELA_MENIT=15  LOGIN_KUNCI_MENIT=15
# WAJIB_SCAN_WAJAH=true  AMBANG_WAJAH=0.45  KIOSK_TOKEN=
