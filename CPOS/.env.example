# ===== Aplikasi =====
SECRET_KEY=isi_dengan_random_string_panjang
HASH_SECRET_KEY=isi_dengan_random_string_panjang_lain

# ===== Database =====
DB_SERVER=nama_server_sql
DB_NAME=CPOS
DB_USER=
DB_PASSWORD=

# ===== Server (serve.py) =====
HOST=0.0.0.0
PORT=5000
THREADS=8

# ===== Keamanan =====
SESI_IDLE_MENIT=120
SESI_MAKS_JAM=12

LOGIN_MAKS_GAGAL=5
LOGIN_JENDELA_MENIT=15
LOGIN_KUNCI_MENIT=15

# ==== Wajah =====
AMBANG_WAJAH=0.45

# ==== Kiosk =====
KIOSK_TOKEN=
# HTTPS (deploy/Caddyfile): BEHIND_PROXY=1 dan COOKIE_SECURE=1
BEHIND_PROXY=0
COOKIE_SECURE=0

# ===== Lainnya =====
WAJIB_SCAN_WAJAH=true

# ==== Gabungan (RekapIn & Analytics) =====
# Laporan Pembelian TBS (RekapIn): database ERP (PC dummy) yang punya dbo.tbsdetailybs2 / tbsdetailybsweekly / tbsdetailmonthly.
# Biasanya sama dengan DB_SERVER / DB_NAME / DB_USER / DB_PASSWORD di Analytics\backend\.env. Kosong = dicari di database CPOS.
REKAPIN_ERP_SERVER=
REKAPIN_ERP_DB=
REKAPIN_ERP_USER=
REKAPIN_ERP_PASSWORD=
# Enkripsi koneksi ERP (bawaan no, sama dengan RekapIn lama). Isi yes bila server ERP mewajibkan TLS.
REKAPIN_ERP_ENCRYPT=no
# Harga CPO & Kernel (RekapIn & Dashboard CPOS) dari tabel HARGA RekapIn lama. Semua kosong = tabel dbo.DailyPrice di CPOS.
SQLSERVER_PRICE_TABLE=Main.dbo.HARGA
SQLSERVER_PRICE_SERVER=
SQLSERVER_PRICE_DATABASE=Main
SQLSERVER_PRICE_UID=
SQLSERVER_PRICE_PWD=
SQLSERVER_PRICE_ENCRYPT=no
# Alamat frontend Analytics untuk bingkai /an/<id>. Satu situs (Caddy / IIS): /analytics. Pengembangan: http://localhost:5173/analytics
ANALYTICS_URL=/analytics
